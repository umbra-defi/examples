# Solana devnet RPC
RPC_URL=https://api.devnet.solana.com

# Umbra devnet indexer (only needed if you extend the auditor to scan notes)
INDEXER_API_ENDPOINT=https://utxo-indexer.api-devnet.umbraprivacy.com

# The mint to scope viewing keys to (devnet dUSDC, 6 decimals)
MINT=4oG4sjmopf5MzvTHLE8rpVJ2uyczxfsw2K84SUTpNDx7

# Solana CLI keypair JSON files (64-byte secret arrays).
# SUBJECT = the user being audited (derives viewing keys, issues the grant).
# AUDITOR = the auditor receiving access (MUST be registered on Umbra first).
SUBJECT_KEYPAIR=.keys/subject.json
AUDITOR_KEYPAIR=.keys/auditor.json
