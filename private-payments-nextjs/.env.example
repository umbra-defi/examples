# Copy this file to .env.local and fill in the values.
# `NEXT_PUBLIC_*` vars are exposed to the browser. Everything else is
# server-only.

# Solana cluster the app runs against. mainnet-beta or devnet.
NEXT_PUBLIC_NETWORK=devnet

# Paid / private Solana RPC endpoint. Free public RPCs WILL rate-limit
# under any real load and cause silent scan stalls. Use Helius / Triton /
# QuickNode / Alchemy.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# WebSocket RPC endpoint. Many providers ship a separate WS URL.
# Only used when NEXT_PUBLIC_RPC_TRANSPORT=websocket (see below).
NEXT_PUBLIC_RPC_WS_URL=

# How the SDK awaits transaction confirmation + Arcium MPC callbacks:
#   polling   — HTTP getSignatureStatuses / getAccountInfo loops. Works on ANY
#               RPC, including public api.devnet.solana.com whose WebSocket
#               endpoint refuses subscriptions ("Failed to establish WebSocket
#               subscription"). This is the default; leave it unset for it.
#   websocket — real-time subscriptions: lower latency, fewer RPC calls, but
#               REQUIRES a WS-capable RPC (set NEXT_PUBLIC_RPC_WS_URL too).
NEXT_PUBLIC_RPC_TRANSPORT=polling

# Default token mint the app supports out of the box. Must be on the
# Umbra supported-tokens list. The user can swap later.
NEXT_PUBLIC_DEFAULT_MINT=4oG4sjmopf5MzvTHLE8rpVJ2uyczxfsw2K84SUTpNDx7

# Browser-facing proxy paths. These NEVER change — the browser always
# talks to its own origin via /proxy/... and the rewrites in
# next.config.ts forward to the upstream services below.
NEXT_PUBLIC_INDEXER_URL=/proxy/indexer
NEXT_PUBLIC_RELAYER_URL=/proxy/relayer

# Server-only upstream URLs. These are read by next.config.ts at build
# / start time to wire the /proxy/... rewrites. Browser code NEVER sees
# these.
INDEXER_UPSTREAM=https://utxo-indexer.api-devnet.umbraprivacy.com
RELAYER_UPSTREAM=https://relayer.api-devnet.umbraprivacy.com

# ─────────────────────────────────────────────────────────────────────────────
# MAINNET — to run against mainnet-beta, change the values above to:
#   NEXT_PUBLIC_NETWORK=mainnet-beta
#   NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY   # a PAID RPC
#   NEXT_PUBLIC_DEFAULT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v  # USDC (or USDT/UMBRA/CASH/wSOL)
#   INDEXER_UPSTREAM=https://utxo-indexer.api.umbraprivacy.com
#   RELAYER_UPSTREAM=https://relayer.api.umbraprivacy.com
# Leave NEXT_PUBLIC_RPC_TRANSPORT=polling (works on any RPC). Mainnet = real funds —
# test the full flow on devnet first. Supported mainnet mints: wSOL, USDC, USDT, UMBRA, CASH.
